rce_type":"contemporary_match_report","url":"https://www.donga.com/news//article/all/20010927/7742392/1"},{"source_id":"KVL-SRC-KVA-U21-WORLD-HISTORY-2001","publisher":"대한배구협회","source_type":"official_history","url":"https://www.kva.or.kr/user/usr19Result/searchLeague.do?evtKd=02&gender=M&leagueCd=12"},{"source_id":"KVL-SRC-VOLLEYBOX-U21-KOR-FRA-2001","publisher":"Volleybox","source_type":"historical_match_database_secondary","url":"https://volleybox.net/south-korea-u21-france-u21-c66042"},{"source_id":"KVL-SRC-KOVO-MG-2006-2007","publisher":"한국배구연맹(KOVO)","source_type":"official_media_guide","location":"Google Drive 2006-2007_Mediaguidebook_0.all.pdf"}],"events":[{"event_id":"KVL-NT-KOR-M-U20-2000-AVC","year":2000,"level":"U20","competition_name_ko":"2000 아시아 남자 U20 배구선수권대회","organization":"AVC","result":"5위","participation_status":"participated","roster_status":"final_roster_research_pending","player_id_link_status":"roster_not_yet_reconstructed","source_ids":["KVL-SRC-KVA-U20-HISTORY-2000","KVL-SRC-JVA-U20-HISTORY-2000","KVL-SRC-VOLLEYBOX-U20-KOR-AUS-2000"],"note":"대한배구협회와 JVA 공식 역대성적이 이란 개최 및 한국 5위를 일치하게 기록한다. Volleybox의 당시 경기 데이터에는 윤봉우·이선규가 여러 한국 경기에서 반복적으로 표시되지만 이는 secondary partial participation evidence다. 한국 최종 엔트리 원문 확보 전까지 roster로 승격하거나 Player ID를 연결하지 않는다."},{"event_id":"KVL-NT-KOR-M-U18-2001-AVC","year":2001,"level":"U18","competition_name_ko":"2001 아시아 남자 U18 배구선수권대회","organization":"AVC","result":"2위","participation_status":"participated","roster_status":"final_roster_research_pending","player_id_link_status":"roster_not_yet_reconstructed","source_ids":["KVL-SRC-KVA-U18-HISTORY-2001","KVL-SRC-JVA-U18-HISTORY-2001","KVL-SRC-MAEIL-U18-KPRK-2001","KVL-SRC-SBS-YONHAP-U18-KPRK-2001"],"note":"대한배구협회와 JVA 공식 역대성적이 이란 개최, 이란 우승, 한국 준우승을 일치하게 기록한다. 북한전 당시 기사로 김은호·이건호·박대흥·강동진의 실제 출전을 확인했지만 이는 최종 12인 전체 원문이 아니므로 roster로 승격하지 않는다. 강동진은 이미 다른 공식 이름+DOB 근거로 KVL-P-001631이 존재하므로 research evidence에서만 기존 ID를 참조한다."},{"event_id":"KVL-NT-KOR-M-U19-2001-FIVB","year":2001,"level":"U19","competition_name_ko":"2001 FIVB 남자 U19 세계선수권대회","organization":"FIVB","result":"6위","participation_status":"participated","roster_status":"final_roster_research_pending","player_id_link_status":"roster_not_yet_reconstructed","source_ids":["KVL-SRC-KVA-U19-WORLD-HISTORY-2001","KVL-SRC-FIVB-U19-LEGACY-2001","KVL-SRC-KHAN-U19-CZE-2001","KVL-SRC-DONGA-U19-CZE-2001"],"note":"대한배구협회 공식 역대성적은 이집트 개최 및 한국 6위를 기록한다. 체코전 당시 경향신문·동아일보 기사로 강동진·임동규의 실제 출전을 확인했다. 두 선수는 이미 다른 공식 이름+DOB 근거로 각각 KVL-P-001631·KVL-P-001634가 존재하므로 research evidence에서만 기존 ID를 참조하며, 한국 최종 12인 전체 원문 확보 전까지 roster를 확정하지 않는다."},{"event_id":"KVL-NT-KOR-M-U21-2001-FIVB","year":2001,"level":"U21","competition_name_ko":"2001 FIVB 남자 U21 세계선수권대회","organization":"FIVB","result":"6위","participation_status":"participated","roster_status":"final_roster_research_pending","player_id_link_status":"roster_not_yet_reconstructed","source_ids":["KVL-SRC-KVA-U21-WORLD-HISTORY-2001","KVL-SRC-VOLLEYBOX-U21-KOR-FRA-2001","KVL-SRC-KOVO-MG-2006-2007"],"note":"대한배구협회 공식 역대성적은 폴란드 개최 및 한국 6위를 기록한다. Volleybox 경기 데이터에서 윤봉우·이선규가 이탈리아·우크라이나·폴란드·프랑스전 등 여러 경기에서 반복적으로 표시된다. KOVO 2006-2007 공식 미디어가이드는 이선규 이름과 1981.3.14 생년월일을 같은 프로필에서 확인하지만, 당시 U21 대회자료에는 DOB가 없어 exact name+DOB tournament identity 연결 요건을 아직 충족하지 못한다. 윤봉우는 KOVO 프로필의 날짜 표기가 '1982.11/20 (음력)'으로 추출되는 반면 후대 국제 데이터는 1982-01-20을 사용하여 identity-field conflict를 별도 해결해야 한다. 두 선수 모두 이번 단계에서는 신규 Player ID를 발급하지 않는다."}],"rosters":[],"research_evidence":[{"evidence_id":"KVL-EVIDENCE-KOR-U20-2000-MATCHES","event_id":"KVL-NT-KOR-M-U20-2000-AVC","evidence_type":"secondary_repeated_match_participation_not_final_roster","source_ids":["KVL-SRC-VOLLEYBOX-U20-KOR-AUS-2000"],"players":[{"name_ko":"윤봉우","identity_status":"official_identity_date_conflict_unresolved"},{"name_ko":"이선규","candidate_birth_date":"1981-03-14","identity_source_id":"KVL-SRC-KOVO-MG-2006-2007","identity_status":"official_identity_verified_but_tournament_dob_missing"}],"note":"Volleybox의 2000 U20 한국-호주전 및 동일 대회 복수 한국 경기 페이지에서 두 이름이 반복적으로 확인된다. secondary match database이므로 최종 엔트리 증빙으로 사용하지 않는다."},{"evidence_id":"KVL-EVIDENCE-KOR-U18-2001-KPRK-MATCH","event_id":"KVL-NT-KOR-M-U18-2001-AVC","evidence_type":"partial_match_participation_not_final_roster","source_ids":["KVL-SRC-MAEIL-U18-KPRK-2001","KVL-SRC-SBS-YONHAP-U18-KPRK-2001"],"players":[{"name_ko":"김은호","affiliation_as_reported":"남성고"},{"name_ko":"이건호","affiliation_as_reported":"벌교상고"},{"name_ko":"박대흥","affiliation_as_reported":"문일고"},{"name_ko":"강동진","affiliation_as_reported":"벌교상고","player_id":"KVL-P-001631","player_id_reference_status":"existing_id_from_separate_official_exact_name_dob_verification"}],"note":"2001 아시아 남자 U18 북한전 contemporaneous match reports에서 실제 경기 참가가 확인되는 선수만 기록. 이 자료는 최종 대회 엔트리 12명 전체를 증명하지 않는다. 기존 ID 참조는 새 ID 발급이 아니라 이미 검증된 identity를 research evidence에 연결한 것이다."},{"evidence_id":"KVL-EVIDENCE-KOR-U19-2001-CZE-MATCH","event_id":"KVL-NT-KOR-M-U19-2001-FIVB","evidence_type":"partial_match_participation_not_final_roster","source_ids":["KVL-SRC-KHAN-U19-CZE-2001","KVL-SRC-DONGA-U19-CZE-2001"],"players":[{"name_ko":"강동진","affiliation_as_reported":"벌교상고","player_id":"KVL-P-001631","player_id_reference_status":"existing_id_from_separate_official_exact_name_dob_verification"},{"name_ko":"임동규","affiliation_as_reported":"인창고","player_id":"KVL-P-001634","player_id_reference_status":"existing_id_from_separate_official_exact_name_dob_verification"}],"note":"2001 FIVB 남자 U19 세계선수권 체코전 contemporaneous match reports에서 실제 출전이 확인되는 선수. 최종 12인 전체가 아니므로 roster로 승격하지 않는다."},{"evidence_id":"KVL-EVIDENCE-KOR-U21-2001-MATCHES","event_id":"KVL-NT-KOR-M-U21-2001-FIVB","evidence_type":"secondary_repeated_match_participation_not_final_roster","source_ids":["KVL-SRC-VOLLEYBOX-U21-KOR-FRA-2001","KVL-SRC-KOVO-MG-2006-2007"],"players":[{"name_ko":"윤봉우","identity_status":"official_identity_date_conflict_unresolved","identity_warning":"KOVO 2006-2007 프로필 날짜 표기와 후대 국제 DOB 표기가 충돌하므로 영구 ID 발급 보류."},{"name_ko":"이선규","candidate_birth_date":"1981-03-14","identity_source_id":"KVL-SRC-KOVO-MG-2006-2007","identity_status":"official_identity_verified_but_tournament_dob_missing","identity_warning":"KOVO 신원 DOB는 확인됐지만 2001 U21 대회 원문 DOB가 없어 strict exact-match linking은 보류."}],"note":"2001 U21 복수 경기에서 두 선수가 반복적으로 나타나는 강한 참가 단서지만 secondary database이고 최종 12인 전체를 제공하지 않는다."}],"notes":["2000-2001 구간은 대회 참가 및 최종성적부터 공식 기록으로 확정하고, 최종 엔트리는 별도 원문 복원 후 추가한다.","U18-U19 또는 U20-U21 사이에 연령대가 겹치더라도 다른 대회 roster를 복사하거나 추정 보완하지 않는다.","경기기사와 secondary 경기 DB에서 확인된 부분 참가자는 research_evidence로만 보존하고 최종 roster와 분리한다.","기존 Player ID가 이미 다른 공식 exact name+DOB 검증으로 발급된 경우 research_evidence에서 참조할 수 있으나, 그것만으로 해당 대회의 final roster linked 상태로 승격하지 않는다.","영구 Player ID 신규 발급은 이름+생년월일 exact match가 해당 historical identity를 뒷받침하는 공식 원문으로 확인될 때만 수행한다."]}